    {
      "name": "TC-M3-02A - Get CSRF Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Manage Records page loads successfully\", function () {\n    pm.response.to.have.status(200);\n});\n\nconst html = pm.response.text();\n\nconst match = html.match(/name=[\"']csrf_token[\"'][^>]*value=[\"']([^\"']+)[\"']/);\n\npm.test(\"CSRF token is found\", function () {\n    pm.expect(match).to.not.be.null;\n});\n\nif (match) {\n    pm.collectionVariables.set(\"csrfToken\", match[1]);\n}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "GET",
        "header": [],
        "url": {
