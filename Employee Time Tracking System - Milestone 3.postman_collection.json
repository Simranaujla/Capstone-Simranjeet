    {
      "name": "TC-M3-00 - Employee Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login redirects to dashboard\", function () {\n    pm.response.to.have.status(302);\n});\n\npm.test(\"Login creates a PHP session\", function () {\n    pm.expect(pm.cookies.has(\"PHPSESSID\")).to.be.true;\n});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "{{employeeEmail}}"
            },
            {
              "key": "password",
              "value": "{{employeePassword}}"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8888/capstone-Simranaujla/pages/login.php",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8888",
          "path": [
            "capstone-Simranaujla",
            "pages",
            "login.php"
          ]
        }
      },
      "response": []
    },
